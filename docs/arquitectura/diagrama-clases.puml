@startuml
skinparam classAttributeIconSize 0

abstract class Socio {
    - numeroSocio: int
    - nombre: String
    - apellido: String
    - documento: String
    - telefono: String
    - correoElectronico: String
    - fechaIngreso: Date
    - situacionAdministrativa: SituacionAdministrativa
    --
    + puedeReservar(): boolean
    + getNumeroSocio(): int
    + getNombre(): String
    + getApellido(): String
    + getDocumento(): String
    + getTelefono(): String
    + getCorreoElectronico(): String
    + getFechaIngreso(): Date
    + getSituacionAdministrativa(): SituacionAdministrativa
    + cambiarSituacionAdministrativa(nueva: SituacionAdministrativa): void
}

class SocioActivo extends Socio {
    - {static} porcentajeDescuentoRecargo: double = 0.0
    --
    + {static} setPorcentajeDescuentoRecargo(porcentaje: double): void
    + calcularImporteFinal(precioBaseTotal: double): double
    + getPorcentajeAjuste(): double
}

class SocioVitalicio extends Socio {
    - {static} porcentajeDescuento: double
    - vitalicioDesde: DateTime
    --
    + {static} setPorcentajeDescuento(porcentaje: double): void
    + calcularImporteFinal(precioBaseTotal: double): double
    + getPorcentajeAjuste(): double
    + getVitalicioDesde() : DateTime
}

class SocioAdherente extends Socio {
    - {static} porcentajeRecargo: double
    --
    + {static} setPorcentajeRecargo(porcentaje: double): void
    + calcularImporteFinal(precioBaseTotal: double): double
    + getPorcentajeAjuste(): double
}

abstract class EstadoPago {
    --
    + getNombre(): String
    + puedeCancelarse(): boolean
}

class Pendiente extends EstadoPago {
}

class Aprobado extends EstadoPago {
}

class Rechazado extends EstadoPago {
}

class Cancelado extends EstadoPago {
}

abstract class Recurso {
    - codigo: String
    - descripcion: String
    - capacidadMaxima: int
    - precioBaseHora: double
    - habilitado: boolean
    --
    + estaDisponible(fecha: Date, horaInicio: Time, horas: int): boolean
    + devolverTipo(): String
    + getCodigo(): String
    + getDescripcion(): String
    + getCapacidadMaxima(): int
    + getPrecioBaseHora(): double
    + isHabilitado(): boolean
}

class Quincho extends Recurso {
    - esCerrado: boolean
    - tieneFreezer: boolean
    - cantidadMesas: int
    --
    + isEsCerrado(): boolean
    + isTieneFreezer(): boolean
    + getCantidadMesas(): int
}

class Salon extends Recurso {
    - tieneAireAcondicionado: boolean
    - poseeEscenario: boolean
    --
    + isTieneAireAcondicionado(): boolean
    + isPoseeEscenario(): boolean
}

class Cancha extends Recurso {
    - tipoDeporte: String
    - tieneIluminacion: boolean
    --
    + getTipoDeporte(): String
    + isTieneIluminacion(): boolean
}

class Parrilla extends Recurso {
    - capacidadKgCarne: double
    --
    + getCapacidadKgCarne(): double
}

class EspacioRecreacion extends Recurso {
    - tipoEspacio: String
    --
    + getTipoEspacio(): String
}

class Reserva {
    - numeroReserva: String
    - fechaCreacion: DateTime
    - fechaUso: Date
    - horarioInicio: Time
    - duracionHoras: int
    - importeTotal: double
    - importeAbonado: double
    - saldoPendiente: double
    - estado: EstadoReserva
    --
    + calcularImporteTotal(): double
    + confirmar(): void
    + cancelar(): void
    + finalizar(): void
    + getNumeroReserva(): String
    + getFechaCreacion(): DateTime
    + getFechaUso(): Date
    + getHorarioInicio(): Time
    + getDuracionHoras(): int
    + getImporteTotal(): double
    + getImporteAbonado(): double
    + getSaldoPendiente(): double
    + getEstado(): EstadoReserva
    + cambiarEstado(nuevo: EstadoReserva): void
}

abstract class EstadoReserva {
    --
    + getNombre(): String
    + puedeCancelarse(): boolean
}

class PagoParcial extends EstadoReserva {
}

class Confirmada extends EstadoReserva {
}

class Cancelada extends EstadoReserva {
}

class Finalizada extends EstadoReserva {
}

note right of Reserva: el medio de pago utilizado\nse obtiene del tipo concreto\nde Pago asociado (PagoCredito,\nPagoDebito o PagoBilleteraVirtual),\nno se duplica como atributo.

abstract class Pago {
    - idPago: String
    - monto: double
    - fechaHora: DateTime
    - codigoAutorizacion: String
    - estado: EstadoPago
    --
    + getFechaHora(): DateTime
    + procesarPago(): boolean
    + getIdPago(): String
    + getMonto(): double
    + getCodigoAutorizacion(): String
    + getEstado(): EstadoPago
    + cambiarEstado(nuevo: EstadoPago): void
}

note left of Pago: codigoAutorizacion\n representa al código que\nretorna la pasarela de pagos\nal aprobar la operación.

class PagoCredito extends Pago {
    - bancoEmisor: String
    - cantCuotas: int
    - interesAplicado: double
    --
    + getBancoEmisor(): String
    + getCantCuotas(): int
    + getInteresAplicado(): double
}

class PagoDebito extends Pago {
    - bancoEmisor: String
    - cbu: String
    - titularCuenta: String
    --
    + getTitularCuenta() : String
    + getBancoEmisor(): String
    + getCbu(): String
}

class PagoBilleteraVirtual extends Pago {
    - nombrePlataforma: String
    - cvu: String
    - alias: String
    --
    + getNombrePlataforma(): String
    + getCvu(): String
    + getAlias(): String
}

class Club {
    --
    + registrarSocio(socio: Socio): void
    + registrarRecurso(recurso: Recurso): void
    + configurarAjusteCategoriaSocioActivo(porcentaje: double): void
    + configurarAjusteCategoriaSocioVitalicio(porcentaje: double): void
    + configurarAjusteCategoriaSocioAdherente(porcentaje: double): void
    + registrarReserva(reserva: Reserva): void
    + verificarSituacionAdministrativa(socio: Socio): boolean
    + confirmarReserva(reserva: Reserva): void
    + cancelarReserva(reserva: Reserva): void
    + consultarReservasPorSocio(socio: Socio): Reserva[]
    + consultarReservasPorRecursoYFecha(recurso: Recurso, fecha: Date): Reserva[]
    + generarInformeReservasDelDia(fecha: Date): String
    - enviarEmailConfirmacion(reserva: Reserva): void
}

abstract class SituacionAdministrativa {
    --
    + puedeReservar(): boolean
    + getNombre(): String
}

class Habilitado extends SituacionAdministrativa {
}

class Suspendido extends SituacionAdministrativa {
}

class DadoDeBaja extends SituacionAdministrativa {
}

class Moroso extends SituacionAdministrativa {
}

note right of Club: registrarReserva() genera el número\nde reserva, la almacena y llama a\nenviarEmailConfirmacion() para notificar\nal socio con los datos de la reserva.

Club "1" -- "0..*" Socio : registra >
Club "1" -- "0..*" Recurso : administra >
Club "1" -- "0..*" Reserva : gestiona >
Pago "1" -- "1" EstadoPago : tiene >
Socio "1" -- "0..*" Reserva : realiza >
Socio "1" -- "1" SituacionAdministrativa : tiene >
Recurso "1" -- "0..*" Reserva : es reservado en >
Reserva "1" -- "1..*" Pago : registra >
Reserva "1" -- "1" EstadoReserva : tiene >
@enduml