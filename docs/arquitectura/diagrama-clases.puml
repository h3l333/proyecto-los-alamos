@startuml
skinparam classAttributeIconSize 0

class Socio {
    - numeroSocio: int
    - nombre: String
    - apellido: String
    - documento: String
    - telefono: String
    - correoElectronico: String
    - fechaIngreso: Date
    - situacionAdministrativa: SituacionAdmin
    - tipo: TipoSocio
    --
    + puedeReservar(): boolean
    + getNumeroSocio(): int
    + getNombre(): String
    + getApellido(): String
    + getDocumento(): String
    + getTelefono(): String
    + getCorreoElectronico(): String
    + getFechaIngreso(): Date
    + getTipoSocio(): TipoSocio
    + getSituacionAdministrativa(): SituacionAdmin
    + setSituacionAdmin(nueva: SituacionAdmin): void
}

abstract class TipoSocio {
    - descripcion: String
    - porcentajeAjuste: BigDecimal
    --
    + getDescripcion(): String
    + getPorcentajeAjuste(): BigDecimal
    + setPorcentajeAjuste(porcentaje: BigDecimal): void
    + aplicarAjuste(importe: BigDecimal): BigDecimal
}

class Activo extends TipoSocio {
}

class Adherente extends TipoSocio {
}

class SocioVitalicio extends TipoSocio {
}

note right of TipoSocio: porcentajeAjuste se expresa como fracción:\npositivo = recargo, negativo = descuento.\nCada categoría es un singleton (constructor\nprivado y getInstancia()), igual que los\nestados de Reserva y las\nsituaciones administrativas.

note as NotaSingletons
    PagoParcial, Confirmada, Cancelada, Finalizada,
    Habilitado, Suspendido, DadoDeBaja y Moroso son
    singletons: constructor privado y getInstancia().
end note

abstract class Recurso {
    - codigo: String
    - descripcion: String
    - capacidadMaxima: int
    - precioBaseHora: BigDecimal
    - habilitado: boolean
    --
    + estaDisponible(fecha: Date, horaInicio: Time, horas: int): boolean
    + devolverTipo(): String
    + getCodigo(): String
    + getDescripcion(): String
    + getCapacidadMaxima(): int
    + getPrecioBaseHora(): BigDecimal
    + isHabilitado(): boolean
}

class Quincho extends Recurso {
    - esCerrado: boolean
    - tieneFreezer: boolean
    - cantidadMesas: int
    --
    + isEsCerrado(): boolean
    + isTieneFreezer(): boolean
    + getCantidadMesas(): int
}

class Salon extends Recurso {
    - tieneAireAcondicionado: boolean
    - poseeEscenario: boolean
    --
    + isTieneAireAcondicionado(): boolean
    + isPoseeEscenario(): boolean
}

class Cancha extends Recurso {
    - tipoDeporte: String
    - tieneIluminacion: boolean
    --
    + getTipoDeporte(): String
    + isTieneIluminacion(): boolean
}

class Parrilla extends Recurso {
    - capacidadKgCarne: double
    --
    + getCapacidadKgCarne(): double
}

class EspacioRecreacion extends Recurso {
    - tipoEspacio: String
    --
    + getTipoEspacio(): String
}

class Reserva {
    - numeroReserva: int
    - fechaCreacion: DateTime
    - fechaUso: Date
    - horarioInicio: Time
    - duracionHoras: int
    - importeTotal: BigDecimal
    - importeAbonado: BigDecimal
    - saldoPendiente: BigDecimal
    - estado: EstadoReserva
    ~ {static} ESCALA_IMPORTE: int = 2
    ~ {static} REDONDEO_IMPORTE: RoundingMode = HALF_UP
    --
    + calcularImporteTotal(): BigDecimal
    + registrarPago(pago: Pago): void
    + confirmar(): void
    + cancelar(): void
    + finalizar(): void
    + resumen(): String
    + getMedioPago(): String
    + getSocio(): Socio
    + getRecurso(): Recurso
    + getNumeroReserva(): int
    + getFechaCreacion(): DateTime
    + getFechaUso(): Date
    + getHorarioInicio(): Time
    + getDuracionHoras(): int
    + getImporteTotal(): BigDecimal
    + getImporteAbonado(): BigDecimal
    + getSaldoPendiente(): BigDecimal
    + getEstado(): EstadoReserva
    + cambiarEstado(nuevo: EstadoReserva): void
}

abstract class EstadoReserva {
    - nombre: String
    --
    + getNombre(): String
    + puedeCancelarse(): boolean
}

class PagoParcial extends EstadoReserva {
}

class Confirmada extends EstadoReserva {
}

class Cancelada extends EstadoReserva {
}

class Finalizada extends EstadoReserva {
}

note right of Reserva: el medio de pago utilizado\nse obtiene del tipo concreto\nde Pago asociado (PagoCredito,\nPagoDebito o PagoBilleteraVirtual)\nmediante getMedioPago(),\nno se duplica como atributo.\nconfirmar(), cancelar() y finalizar()\nlanzan IllegalStateException si el\nestado actual no admite la operación.

abstract class Pago {
    - idPago: String
    - monto: BigDecimal
    - fechaHora: DateTime
    --
    + getFechaHora(): DateTime
    + getMedioPago(): String
    + getIdPago(): String
    + getMonto(): BigDecimal
}

class PagoCredito extends Pago {
    - bancoEmisor: String
    - cantCuotas: int
    --
    + getBancoEmisor(): String
    + getCantCuotas(): int
}

class PagoDebito extends Pago {
    - bancoEmisor: String
    - cbu: String
    - titularCuenta: String
    --
    + getTitularCuenta() : String
    + getBancoEmisor(): String
    + getCbu(): String
}

class PagoBilleteraVirtual extends Pago {
    - nombrePlataforma: String
    - cvu: String
    - alias: String
    --
    + getNombrePlataforma(): String
    + getCvu(): String
    + getAlias(): String
}

class Club {
    - {static} PORCENTAJE_PAGO_INICIAL: BigDecimal = 0.5
    - reservasPorCreacion: Reserva[]
    - proximoNumeroReserva: int
    --
    + registrarSocio(socio: Socio): void
    + obtenerSocio(numeroSocio: int): Socio
    + obtenerReserva(numeroReserva: int): Reserva
    + darSocioDeBaja(numeroSocio: int): void
    + suspenderSocio(numeroSocio: int): void
    + marcarSocioMoroso(numeroSocio: int): void
    + registrarRecurso(recurso: Recurso): void
    + configurarAjusteCategoriaSocioActivo(porcentaje: BigDecimal): void
    + configurarAjusteCategoriaSocioVitalicio(porcentaje: BigDecimal): void
    + configurarAjusteCategoriaSocioAdherente(porcentaje: BigDecimal): void
    + calcularPagoInicial(numeroSocio: int, codigoRecurso: String, duracionHoras: int): BigDecimal
    + registrarReserva(numeroSocio: int, codigoRecurso: String, fechaUso: Date, horarioInicio: Time, duracionHoras: int, pagoInicial: Pago): Reserva
    + verificarSituacionAdministrativa(numeroSocio: int): boolean
    + confirmarReserva(numeroReserva: int, pagoSaldo: Pago): void
    + cancelarReserva(numeroReserva: int): void
    + finalizarReserva(numeroReserva: int): void
    + consultarReservasPorSocio(numeroSocio: int): Reserva[]
    + consultarReservasPorRecursoYFecha(codigoRecurso: String, fecha: Date): Reserva[]
    + generarInformeReservasDelDia(fecha: Date): String
}

abstract class SituacionAdmin {
    - descSituacionAdmin: String
    --
    + puedeReservar(): boolean
    + getSituacionAdmin(): String
}

class Habilitado extends SituacionAdmin {
}

class Suspendido extends SituacionAdmin {
}

class DadoDeBaja extends SituacionAdmin {
}

class Moroso extends SituacionAdmin {
}

class ClubMenuUI {
    --
    + iniciar(): void
}

class Main {
    --
    + {static} main(args: String[]): void
}

note right of Club: obtenerSocio() y obtenerReserva()\nlanzan IllegalArgumentException si\nno existen. registrarReserva() valida el pago\ninicial, genera el número de reserva,\nla almacena y simula por consola\nel envío del email al socio con los\ndatos de la reserva.

Main "1" -- "1" ClubMenuUI : instancia >
ClubMenuUI "1" -- "1" Club : depende de >
Club "1" -- "0..*" Socio : registra >
Club "1" -- "0..*" Recurso : administra >
Club "1" -- "0..*" Reserva : gestiona >
Socio "1" -- "0..*" Reserva : realiza >
Socio "1" -- "1" SituacionAdmin : tiene >
Socio "1" -- "1" TipoSocio : pertenece a >
Recurso "1" -- "0..*" Reserva : es reservado en >
Reserva "1" -- "1..*" Pago : registra >
Reserva "1" -- "1" EstadoReserva : tiene >
@enduml